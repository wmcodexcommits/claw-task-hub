# Optional Claw Task Hub local configuration.
# Defaults are local-first and safe for development.

# CLAW_TASK_HUB_DB=data/claw-task-hub.sqlite
# PORT=4781
# CLAW_TASK_HUB_HOST=127.0.0.1
# CLAW_TASK_HUB_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# VITE_CLAW_TASK_HUB_API_BASE=http://127.0.0.1:4781/api

# Required only if you intentionally bind the API outside loopback.
# Do not use this without your own authentication and network controls.
# CLAW_TASK_HUB_UNSAFE_BIND=1

# External (Postgres/Supabase) connections, registered from the database menu
# with "Use an environment variable", read their connection string from a
# variable named here rather than storing it in data/.claw-task-hub-connections.json.
# See docs/EXTERNAL_DATABASES.md. Use a real .env (gitignored), never this file.
# CLAW_TASK_HUB_PG_EXAMPLE_URL=postgres://user:password@host:5432/database

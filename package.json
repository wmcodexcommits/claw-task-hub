{
  "name": "claw-task-hub",
  "private": true,
  "description": "Local-first, Linear-like task hub for AI agents and agentic harnesses.",
  "version": "0.2.0",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "bun run hooks:install",
    "hooks:install": "bun scripts/install-git-hooks.mjs",
    "dev": "concurrently \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vite",
    "pilot:start": "sh scripts/clawtaskhub-posix.sh start",
    "pilot:stop": "sh scripts/clawtaskhub-posix.sh stop",
    "pilot:status": "sh scripts/clawtaskhub-posix.sh status",
    "pilot:restart": "sh scripts/clawtaskhub-posix.sh restart",
    "api": "bun server/index.ts",
    "seed": "bun server/seed.ts",
    "hub": "bun server/hub-cli.ts",
    "open:context": "bun tools/open-context.ts",
    "codex:open": "bun tools/open-context.ts --harness codex --open",
    "migrate:linear": "bun tools/linear-migration/migrate-linear.ts",
    "migrate:postgres": "bun tools/migrate-sqlite-to-postgres.ts",
    "sync:requisitions": "bun tools/sync-requisition-tickets.ts",
    "mcp": "bun server/mcp-server.ts",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "css:generate": "bun scripts/generate-css.ts",
    "css:check": "bun scripts/generate-css.ts --check",
    "contract:generate": "bun scripts/generate-execution-contract-doc.ts",
    "contract:check": "bun scripts/generate-execution-contract-doc.ts --check",
    "build": "tsc -b && bun run check:server && vite build",
    "lint": "eslint .",
    "store-regression": "bun tests/store-regression.mjs",
    "statement-cache": "bun tests/statement-cache.mjs",
    "execution-contract": "bun tests/execution-contract.mjs",
    "execution-attempts": "bun tests/execution-attempts.mjs",
    "execution-workspaces": "bun tests/execution-workspaces.mjs",
    "execution-adapters": "bun tests/execution-adapters.mjs",
    "execution-evidence": "bun tests/execution-evidence.mjs",
    "runnable-issues": "bun tests/runnable-issues.mjs",
    "execution-conflicts": "bun tests/execution-conflicts.mjs",
    "execution-acceptance": "bun tests/execution-acceptance.mjs",
    "execution-reconciliation": "bun tests/execution-reconciliation.mjs",
    "adapter-concurrency": "bun tests/db-adapter-concurrency.mjs",
    "adapter-postgres": "bun tests/db-adapter-postgres.mjs",
    "data-change-relay": "bun tests/data-change-relay.mjs",
    "store-postgres": "bun tests/store-postgres.mjs",
    "pinned-external-db": "bun tests/pinned-external-db.mjs",
    "multiprocess-contention": "bun tests/multiprocess-contention.mjs",
    "harness-smoke": "bun tests/harness-smoke.mjs",
    "open-context-smoke": "bun tests/open-context-smoke.mjs",
    "posix-launcher-smoke": "bun tests/posix-launcher-smoke.mjs",
    "ui-smoke": "bunx playwright install chromium && bun tests/ui-smoke.mjs",
    "control-plane-e2e": "bunx playwright install chromium && bun tests/control-plane-e2e.mjs",
    "public-hygiene": "bun tests/public-hygiene.mjs",
    "release:version": "bun scripts/check-release-version.mjs",
    "release:package": "bun scripts/package-release.mjs",
    "release-package-smoke": "bun tests/release-package-smoke.mjs",
    "verify:deps": "bun install --frozen-lockfile",
    "verify:static": "bun run css:check && bun run contract:check && bun run public-hygiene && bun run build && bun run lint && bun run release:version",
    "test": "bun run store-regression && bun run statement-cache && bun run execution-contract && bun run execution-attempts && bun run execution-workspaces && bun run execution-adapters && bun run execution-evidence && bun run runnable-issues && bun run execution-conflicts && bun run execution-acceptance && bun run execution-reconciliation && bun run adapter-concurrency && bun run adapter-postgres && bun run data-change-relay && bun run store-postgres &&bun run multiprocess-contention && bun run harness-smoke && bun run open-context-smoke && bun run posix-launcher-smoke && bun run ui-smoke && bun run control-plane-e2e && bun run release-package-smoke",
    "verify": "bun run verify:deps && bun run verify:static && bun run test",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.11",
    "postgres": "^3.4.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.10.0",
    "globals": "^17.5.0",
    "lightningcss": "^1.32.0",
    "playwright": "^1.60.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}

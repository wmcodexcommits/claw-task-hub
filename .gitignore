# Claude Code local configuration. launch.json records absolute paths to
# executables on this machine, and settings.local.json is per-machine by
# convention. Scoped to those two rather than all of .claude/, so project
# config that is meant to be shared can still be tracked.
.claude/launch.json
.claude/settings.local.json

